# Copy to .env and adjust. Every value below works with `docker compose up -d`.

# Application connects as a non-owner role so row-level security applies.
DATABASE_URL=postgres://orqivanta_app:orqivanta_app@localhost:5433/orqivanta
# Migrations and seeding run as the schema owner.
DATABASE_ADMIN_URL=postgres://orqivanta_owner:orqivanta_owner@localhost:5433/orqivanta

APP_URL=http://localhost:3000

# Email: "smtp" (Mailpit locally), "resend" (needs RESEND_API_KEY) or "log" (stored only).
# Every email is also copied to the development mailbox at /dev/mailbox.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Orqivanta <hello@orqivanta.local>"
RESEND_API_KEY=

# Private file storage. Files are never served from a public path.
STORAGE_DIR=.storage
MAX_UPLOAD_MB=25

# Enables the demo role switcher and /dev/mailbox. Keep off for a real deployment.
DEMO_MODE=true
